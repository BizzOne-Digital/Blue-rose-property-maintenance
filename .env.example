# ── MongoDB (required for production admin + catalog persistence) ──
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=blue_rose

# ── Admin portal (/admin) — used by db:seed and login ──
ADMIN_EMAIL=admin@bluerosepropertymaintenance.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Signs admin session cookies (optional; falls back to ADMIN_PASSWORD if empty)
SESSION_SECRET=

# ── Site email (booking/contact) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_TO=
