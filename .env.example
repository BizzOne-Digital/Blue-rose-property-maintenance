# ── MongoDB (required for production admin + catalog persistence) ──
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=blue_rose

# ── Admin portal (/admin) — used by db:seed and login ──
ADMIN_EMAIL=admin@bluerosepropertymaintenance.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Signs admin session cookies (optional; falls back to ADMIN_PASSWORD if empty)
SESSION_SECRET=

# ── Site email (booking/contact) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# ── Google tag / lead tracking ──
# Google tag ID(s), comma separated: GA4 "G-XXXXXXXXXX" and/or Google Ads "AW-XXXXXXXXX".
NEXT_PUBLIC_GOOGLE_TAG_ID=
# Optional Google Ads conversion targets ("AW-XXXXXXXXX/label") for call clicks and form leads.
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION=
